function buildMonthlyDashboard() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const pivotSheet = ss.getSheetByName("Monthly_Consumption_Pivot");
  const dashSheet = ss.getSheetByName("Monthly_Dashboard");

  dashSheet.clear();

  // -------------------------------
  // 1. READ MONTHLY PIVOT DATA
  // -------------------------------
  const data = pivotSheet.getRange(2, 1, pivotSheet.getLastRow() - 1, pivotSheet.getLastColumn()).getValues();
  const headers = pivotSheet.getRange(1, 1, 1, pivotSheet.getLastColumn()).getValues()[0];

  const weekCols = [1, 2, 3, 4, 5]; // Week1–Week5 column indexes
  const totalCol = 6; // Total_Monthly column index

  // -------------------------------
  // 2. SUMMARY METRICS
  // -------------------------------
  let totalMonthlyUsage = 0;
  let highestItem = "";
  let highestValue = 0;
  let lowestItem = "";
  let lowestValue = Infinity;

  data.forEach(row => {
    const item = row[0];
    const total = row[totalCol];

    totalMonthlyUsage += total;

    if (total > highestValue) {
      highestValue = total;
      highestItem = item;
    }

    if (total < lowestValue) {
      lowestValue = total;
      lowestItem = item;
    }
  });

  const avgWeeklyUsage = totalMonthlyUsage / 5;

  // Determine peak week
  let weeklyTotals = [0, 0, 0, 0, 0];
  data.forEach(row => {
    for (let w = 0; w < 5; w++) {
      weeklyTotals[w] += Number(row[weekCols[w]]) || 0;
    }
  });

  const peakWeekIndex = weeklyTotals.indexOf(Math.max(...weeklyTotals)) + 1;

  // -------------------------------
  // 3. WRITE SUMMARY SECTION
  // -------------------------------
  dashSheet.appendRow(["Monthly Summary", ""]);
  dashSheet.appendRow(["Total Items Used", data.length]);
  dashSheet.appendRow(["Highest Consumed Item", highestItem]);
  dashSheet.appendRow(["Lowest Consumed Item", lowestItem]);
  dashSheet.appendRow(["Total Monthly Usage", totalMonthlyUsage]);
  dashSheet.appendRow(["Average Weekly Usage", avgWeeklyUsage]);
  dashSheet.appendRow(["Peak Week", "Week " + peakWeekIndex]);

  dashSheet.appendRow([""]); // spacing

  // -------------------------------
  // 4. WEEKLY BREAKDOWN TABLE
  // -------------------------------
  dashSheet.appendRow(headers);

  data.forEach(row => {
    dashSheet.appendRow(row);
  });

  dashSheet.appendRow([""]); // spacing

  // -------------------------------
  // 5. TOP 10 ITEMS
  // -------------------------------
  dashSheet.appendRow(["Top 10 Items", ""]);

  const sorted = data.sort((a, b) => b[totalCol] - a[totalCol]).slice(0, 10);

  dashSheet.appendRow(["Rank", "Item", "Total Usage"]);

  sorted.forEach((row, index) => {
    dashSheet.appendRow([index + 1, row[0], row[totalCol]]);
  });

  dashSheet.appendRow([""]); // spacing

  // -------------------------------
  // 6. TREND ANALYSIS
  // -------------------------------
  dashSheet.appendRow(["Usage Trends", ""]);
  dashSheet.appendRow(["Item", "Trend"]);

  data.forEach(row => {
    const item = row[0];
    const w1 = Number(row[weekCols[0]]) || 0;
    const w5 = Number(row[weekCols[4]]) || 0;

    let trend = "→ Stable";
    if (w5 > w1) trend = "↑ Increasing";
    if (w5 < w1) trend = "↓ Decreasing";

    dashSheet.appendRow([item, trend]);
  });
}
